{
  "name": "tunnel-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://tunnel-govindplals-projects.vercel.app,https://tunnel-*-govindplals-projects.vercel.app",
    "MAX_MESSAGE_BYTES": "1048576",
    "HOLD_MS": "1800000",
    "HELLO_TIMEOUT_MS": "10000"
  }
}
